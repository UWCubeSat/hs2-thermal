   INPUT           F     RECURSIVE SUBROUTINE LOADQ_C3A1_1769218054                                     GLOBAL                          
   INPUT           F     USE BINARY_READER_MOD                                                          GLOBAL                          
   INPUT                 CALL COMMON                                                                    GLOBAL                          
   INPUT           F     INTEGER NVAR__TD                                                               GLOBAL                          
   INPUT           F     REAL, ALLOCATABLE ::  DATA__TD(:)                                              GLOBAL                          
   INPUT           F     DATA NVAR__TD /-1/                                                             GLOBAL                          
   INPUT           F     SAVE NVAR__TD, DATA__TD                                                        GLOBAL                          
   INPUT           F     IF( NVAR__TD  .LT.  0 ) THEN                                                   GLOBAL                          
   INPUT           F         ALLOCATE (DATA__TD(8381))                                                  GLOBAL                          
   INPUT           F         CALL LOAD_BINARY_SINGLET_ARRAYS(                                           GLOBAL                          
   INPUT           F    +        'C3A1.hra_bin'                                                         GLOBAL                          
   INPUT           F    +    , DATA__TD)                                                                GLOBAL                          
   INPUT           F         NVAR__TD = 1                                                               GLOBAL                          
   INPUT           F     ENDIF                                                                          GLOBAL                          
   INPUT           F     DATA__TD(1 + 867 + 1) =                                                        GLOBAL                          
   INPUT                +     C3A1.A(5+1)                                                               GLOBAL                          
   INPUT           F     CALL LOADQ('C3A1',1,19,                                                        GLOBAL                          
   INPUT           F    +    DATA__TD(1+289),                                                           GLOBAL                          
   INPUT           F    +    DATA__TD(1+578),                                                           GLOBAL                          
   INPUT           F    +    DATA__TD(1),                                                               GLOBAL                          
   INPUT           F    +    DATA__TD(1+867),                                                           GLOBAL                          
   INPUT                +    C3A1.A4)                                                                   GLOBAL                          
   INPUT           F     RETURN                                                                         GLOBAL                          
   INPUT           F     END                                                                            GLOBAL                          
